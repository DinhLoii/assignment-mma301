# Firebase Project Configuration for React Native / Expo
# In Expo SDK 50+, environment variables prefixed with EXPO_PUBLIC_ are automatically available in the client.
# Replace the values below with your Firebase project credentials from Firebase Console:
# Firebase Console -> Project Settings -> General -> Your apps -> Web app (or SDK setup)

EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id
